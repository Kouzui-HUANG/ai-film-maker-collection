---
/**
 * 捲動分批載入（只給 /works/ 用）。
 *
 * 只 SSR 前 MORE_INITIAL 張 WorkCard；其餘捲到底時 fetch `${base}${n}.json`
 * （base = href('/more/<listKey>/')，含 GitHub Pages 的 /<repo> 前綴），
 * 端點在 src/pages/more/[key]/[page].json.ts，每個 JSON 為 MORE_CHUNK 部，前端每批補 MORE_BATCH 部。
 *
 * 新卡片用 clone 第一張 SSR 卡片當模板：Astro scoped style 掛在 data-astro-cid-* 屬性上，
 * clone 才能原封不動帶著那些屬性，不必寫死 hash。
 *
 * 偏移是位置式的，HTML 與 JSON 必須同一次 build，否則作品會重複或被跳過。
 * 兩邊各帶 listVersion() 的版本戳對帳：
 *   - fetch 網址帶 ?v=<version>，避開瀏覽器快取到舊 JSON
 *   - JSON 的 version 與 data-more-version 不符 → 代表這頁 HTML 是舊的，重載一次換回同一版
 *   - 重載後仍不符（中間有代理快取住）就不再重試，改用 href 去重硬撐，至少不會出現重複卡片
 */
import WorkCard from './WorkCard.astro';
import type { Work } from '../data/queries';
import { href } from '../data/site';
import { MORE_INITIAL, MORE_BATCH, MORE_CHUNK, listVersion } from '../data/listings';

interface Props {
  /** 對應 /more/<listKey>/<page>.json 的 key */
  listKey: string;
  /** 完整清單；只有前 MORE_INITIAL 部會進 HTML，其餘捲到底才 fetch */
  works: Work[];
}

const { listKey, works } = Astro.props;

const initial = works.slice(0, MORE_INITIAL);
const total = works.length;
/** 與 /more/<key>/<n>.json 對帳用；對不上代表 HTML 與 JSON 不是同一次 build */
const version = listVersion(works);
const hasMore = total > initial.length;
/** 首屏一列（桌機 3 欄）eager，其餘 lazy */
const EAGER_COUNT = 3;
---

<div
  class="more-list"
  data-more-list
  data-more-key={listKey}
  data-more-base={href(`/more/${listKey}/`)}
  data-more-version={version}
  data-more-total={String(total)}
  data-more-initial={String(initial.length)}
  data-more-batch={String(MORE_BATCH)}
  data-more-chunk={String(MORE_CHUNK)}
>
  <div class="more-list__items" data-more-items>
    {initial.map((w, i) => <WorkCard work={w} loading={i < EAGER_COUNT ? 'eager' : 'lazy'} />)}
  </div>

  {hasMore && (
    <div class="more-list__foot">
      <div class="more-list__sentinel" data-more-sentinel aria-hidden="true"></div>
      <p class="more-list__status" data-more-status role="status" aria-live="polite"></p>
      <noscript>
        <p class="more-list__noscript">
          其餘 {total - initial.length} 部作品請由 <a href={href('/sitemap/')}>網站地圖</a> 或各創作者頁查閱。
        </p>
      </noscript>
    </div>
  )}
</div>

<script>
  type CardCreator = { name: string; href: string };
  type CardData = {
    href: string;
    title: string;
    creators: CardCreator[];
    meta: string;
    awardLabel: string;
    awardStatus: 'winner' | 'finalist' | 'selection' | '';
    awardAriaLabel: string;
    alt: string;
    src: string;
    srcset: string;
  };
  /** 端點現在回 { version, items }；純陣列是舊版 JSON（快取到上一版時），照樣吃 */
  type ChunkPayload = CardData[] | { version?: string; items?: CardData[] };

  /** 「這一版的 HTML 已經重載過一次」的記號，避免代理快取住時無限重載 */
  const RELOAD_KEY = 'more-list:reloaded';

  function setup(root: HTMLElement) {
    const base = root.dataset.moreBase;
    const version = root.dataset.moreVersion ?? '';
    const total = Number(root.dataset.moreTotal ?? '0');
    const initial = Number(root.dataset.moreInitial ?? '0');
    const batch = Number(root.dataset.moreBatch ?? '12');
    const chunk = Number(root.dataset.moreChunk ?? '24');

    const items = root.querySelector<HTMLElement>('[data-more-items]');
    const sentinel = root.querySelector<HTMLElement>('[data-more-sentinel]');
    const status = root.querySelector<HTMLElement>('[data-more-status]');
    if (!base || !items || !sentinel || !status || initial >= total) return;

    const template = items.querySelector<HTMLElement>('[data-work-card]');
    if (!template) return;

    /** 已印出的作品連結；版本錯開時用來擋掉重複卡片（getAttribute 才和 JSON 的 href 同形） */
    const seen = new Set<string>();
    for (const a of items.querySelectorAll<HTMLAnchorElement>('[data-work-card] .card__link')) {
      const h = a.getAttribute('href');
      if (h) seen.add(h);
    }

    const totalChunks = Math.ceil((total - initial) / chunk);
    const buffer: CardData[] = [];
    let nextChunk = 1;
    let rendered = initial;
    let busy = false;
    let stopped = false;
    /** 版本對不上又重載不了：HTML 帶來的 total / totalChunks 都不可信，改抓到沒有為止 */
    let stale = false;
    /** 資料源見底（chunk 抓完、回空陣列，或降級時抓到 404） */
    let exhausted = false;

    /** 還有沒有下一個 chunk 可抓 */
    function hasNextChunk(): boolean {
      if (exhausted) return false;
      return stale || nextChunk <= totalChunks;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) void pump();
      },
      { rootMargin: '400px 0px' },
    );

    function renderCard(data: CardData): HTMLElement {
      const el = template!.cloneNode(true) as HTMLElement;

      const link = el.querySelector<HTMLAnchorElement>('.card__link');
      if (link) link.href = data.href;

      const img = el.querySelector<HTMLImageElement>('.card__figure img');
      if (img) {
        img.src = data.src;
        if (data.srcset) img.srcset = data.srcset;
        else img.removeAttribute('srcset');
        img.alt = data.alt;
        img.loading = 'lazy';
        img.removeAttribute('fetchpriority');
      }

      const badge = el.querySelector<HTMLElement>('.card__badge');
      if (badge) {
        badge.hidden = !data.awardLabel;
        badge.textContent = data.awardLabel;
        if (data.awardStatus) badge.dataset.awardStatus = data.awardStatus;
        else delete badge.dataset.awardStatus;
        if (data.awardAriaLabel) badge.setAttribute('aria-label', data.awardAriaLabel);
        else badge.removeAttribute('aria-label');
      }

      const title = el.querySelector<HTMLElement>('.card__title');
      if (title) title.textContent = data.title;

      const creators = el.querySelector<HTMLElement>('.card__creators');
      if (creators) {
        creators.replaceChildren();
        data.creators.forEach((c, i) => {
          if (i > 0) creators.append('、');
          const a = document.createElement('a');
          a.href = c.href;
          a.textContent = c.name;
          creators.append(a);
        });
      }

      const meta = el.querySelector<HTMLElement>('.card__meta');
      if (meta) meta.textContent = data.meta;

      return el;
    }

    function finish() {
      stopped = true;
      observer.disconnect();
      sentinel!.remove();
      status!.textContent = '';
    }

    /**
     * JSON 的版本戳與這頁 HTML 對不上：這頁是部署前載入的舊版，偏移已經錯位。
     * 重載一次換回同一版；若這一版先前已經重載過（代理還在給舊 HTML），
     * 就不再重試，回 false 讓呼叫端改用 href 去重繼續。
     */
    function handleStale(): boolean {
      let tried = '';
      try {
        tried = sessionStorage.getItem(RELOAD_KEY) ?? '';
      } catch {
        /* 無痕模式等讀不到 sessionStorage：當作沒重載過，最多多刷一次 */
      }
      if (tried === version) return false;

      try {
        sessionStorage.setItem(RELOAD_KEY, version);
      } catch {
        /* 寫不進去也照重載，下面的 stopped 會擋住後續批次 */
      }
      stopped = true;
      observer.disconnect();
      status!.textContent = '清單已更新，重新載入…';
      location.reload();
      return true;
    }

    function fail() {
      observer.disconnect();
      status!.textContent = '';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'more-list__retry';
      btn.textContent = '載入失敗，點此重試';
      btn.addEventListener('click', () => {
        btn.remove();
        observer.observe(sentinel!);
        void pump();
      });
      status!.after(btn);
    }

    async function pump() {
      if (busy || stopped) return;
      if (!stale && rendered >= total) return;
      busy = true;
      status!.textContent = '載入中…';

      try {
        while (buffer.length < batch && hasNextChunk()) {
          // ?v= 只為了避開瀏覽器快取到上一版 JSON；靜態主機會忽略 query
          const url = `${base}${nextChunk}.json${version ? `?v=${encodeURIComponent(version)}` : ''}`;
          const res = await fetch(url);
          if (!res.ok) {
            // 降級時 chunk 數是猜的，404 就當作抓完了
            if (stale && res.status === 404) {
              exhausted = true;
              break;
            }
            throw new Error(`HTTP ${res.status}`);
          }

          const payload = (await res.json()) as ChunkPayload;
          const list = Array.isArray(payload) ? payload : payload.items ?? [];
          const chunkVersion = Array.isArray(payload) ? '' : payload.version ?? '';

          if (version && chunkVersion && chunkVersion !== version) {
            if (handleStale()) return;
            stale = true;
          }

          if (list.length === 0) {
            exhausted = true;
            break;
          }
          buffer.push(...list);
          nextChunk += 1;
        }
        if (!hasNextChunk()) exhausted = true;
      } catch {
        busy = false;
        fail();
        return;
      }

      const next = buffer.splice(0, batch);
      // 版本錯開時同一部作品可能已經在頁面上，去重後才進 DOM
      const fresh = next.filter((d) => d.href && !seen.has(d.href));
      for (const d of fresh) seen.add(d.href);

      if (fresh.length > 0) {
        const frag = document.createDocumentFragment();
        for (const data of fresh) frag.appendChild(renderCard(data));
        items!.appendChild(frag);
        rendered += fresh.length;
      }
      status!.textContent = '';
      busy = false;

      // 資料源見底就收工；total 只在版本相符時才可信，才不會卡在載入中。
      if ((buffer.length === 0 && exhausted) || (!stale && rendered >= total)) {
        finish();
        return;
      }

      // 新內容若不夠高，sentinel 仍留在觸發範圍內，但 IntersectionObserver
      // 只在「跨越門檻」時回呼，不會自己再送一次。重新 observe 可強制它
      // 用目前狀態再回呼一次，讓批次自然接續到 sentinel 被推出畫面為止。
      observer.unobserve(sentinel!);
      observer.observe(sentinel!);
    }

    observer.observe(sentinel);
  }

  document.querySelectorAll<HTMLElement>('[data-more-list]').forEach(setup);
</script>

<style>
  /* 作品網格：桌機 3 欄 → ≤900px 2 欄 → ≤640px 1 欄 */
  .more-list__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px 24px;
    min-width: 0;
  }

  .more-list__sentinel {
    height: 1px;
  }

  .more-list__noscript {
    margin-top: 24px;
    text-align: center;
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .more-list__noscript a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .more-list__status:empty {
    display: none;
  }

  .more-list__status {
    margin-top: 28px;
    text-align: center;
    font-family: var(--font-caps);
    font-size: var(--fs-sm);
    letter-spacing: 0.14em;
    color: var(--muted);
    animation: more-pulse 1.4s var(--ease-out) infinite;
  }

  .more-list :global(.more-list__retry) {
    display: block;
    margin: 28px auto 0;
    padding: 10px 20px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 0;
    box-shadow: 3px 3px 0 var(--shadow);
    font-family: var(--font-caps);
    font-size: var(--fs-sm);
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  .more-list :global(.more-list__retry:hover) {
    color: var(--accent);
    border-color: var(--accent);
  }

  @keyframes more-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @media (max-width: 900px) {
    .more-list__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }

  @media (max-width: 640px) {
    .more-list__items {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .more-list__status {
      animation: none;
    }
  }
</style>
