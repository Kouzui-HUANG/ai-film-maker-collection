---
/**
 * 影片 lite facade（設計文件 §1-3 ②）
 *
 * 預設只渲染縮圖 + 播放鈕，點擊才注入 <iframe>，首屏不載入 YouTube / Vimeo 的 JS。
 * provider 解析不出來（unknown）時不做 facade，改顯示縮圖 + 「在外站觀看」連結。
 * 點擊播放時發 GA4 事件 video_play { work_slug, provider }。
 */
import { Image } from 'astro:assets';
import type { Work } from '../data/queries';
import { parseVideoUrl } from '../data/queries';

interface Props {
  work: Work;
}

const { work } = Astro.props;
const { title, slug, thumb, thumbAlt, videoUrl } = work.data;
const video = parseVideoUrl(videoUrl);

const watchLabel =
  video.provider === 'youtube' ? '在 YouTube 觀看' : video.provider === 'vimeo' ? '在 Vimeo 觀看' : '在原站觀看';
const canEmbed = video.provider !== 'unknown' && !!video.embedUrl;
---

<div class="video">
  <!-- 放映幕：矮螢幕時影片依高度縮小置中，兩側留暗色幕框，片名才排得進第一屏 -->
  <div class="screen">
    {canEmbed ? (
      <div
        class="facade"
        data-embed={video.embedUrl}
        data-title={title}
        data-slug={slug}
        data-provider={video.provider}
      >
        <Image
          src={thumb}
          alt={thumbAlt}
          width={1280}
          height={720}
          widths={[640, 960, 1280]}
          sizes="(max-width: 1240px) 100vw, 1192px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <button type="button" class="facade__play" aria-label={`播放 ${title}`}>
          <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" focusable="false">
            <path d="M7 4.5v15l12-7.5z" fill="currentColor" />
          </svg>
        </button>
      </div>
    ) : (
      <div class="facade facade--static">
        <Image
          src={thumb}
          alt={thumbAlt}
          width={1280}
          height={720}
          widths={[640, 960, 1280]}
          sizes="(max-width: 1240px) 100vw, 1192px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <a
          class="btn facade__external"
          href={videoUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-ga-cta="watch_external"
          data-ga-location="work_video"
        >
          在外站觀看<span class="visually-hidden">（另開新視窗）</span>
        </a>
      </div>
    )}
  </div>

  <p class="video__credit">
    影片外連自 YouTube／Vimeo，版權屬創作者所有。
    <a href={video.watchUrl} target="_blank" rel="noopener noreferrer">{watchLabel}<span class="visually-hidden">（另開新視窗）</span></a>
  </p>
</div>

<script>
  function setup(root: HTMLElement) {
    const btn = root.querySelector<HTMLButtonElement>('.facade__play');
    const embed = root.dataset.embed;
    if (!btn || !embed) return;

    btn.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = embed;
        iframe.title = root.dataset.title ?? '';
        iframe.allow =
          'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.loading = 'lazy';
        iframe.className = 'facade__iframe';
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');

        root.replaceChildren(iframe);
        // 被點擊的按鈕已移除，把焦點交給播放器（WCAG 2.4.3）
        iframe.tabIndex = -1;
        iframe.focus();
        root.classList.add('is-playing');

        (window as any).gtag?.('event', 'video_play', {
          work_slug: root.dataset.slug ?? '',
          provider: root.dataset.provider ?? 'unknown',
        });
      },
      { once: true },
    );
  }

  document.querySelectorAll<HTMLElement>('.facade[data-embed]').forEach(setup);
</script>

<style>
  .video {
    margin: 0 0 20px;
  }

  .screen {
    background: var(--paper-alt);
  }

  /* 16:9 容器；1px 框線、零圓角；縮圖一律全彩 */
  .facade {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    background: var(--paper-alt);
    overflow: hidden;
  }

  /* 桌機：影片高度不超過「螢幕高 − 360px」，標題、創作者與播放鈕同在第一屏；最窄 560px */
  @media (min-width: 861px) {
    .facade {
      width: min(100%, max(calc((100svh - 360px) * 16 / 9), 560px));
      margin-inline: auto;
    }
  }

  .facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--filter-work);
  }

  /* 播放鈕：方形、平面，置中；hover 換成靛藍底 */
  .facade__play {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 76px;
    margin: auto;
    padding: 0 0 0 4px;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--ink);
    border-radius: 0;
    transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out),
      border-color var(--dur-micro) var(--ease-out);
  }

  .facade__play:hover {
    color: var(--accent-text);
    background: var(--accent);
    border-color: var(--accent);
  }

  .facade__play:active {
    color: var(--accent-text);
    background: var(--accent-ink);
    border-color: var(--accent-ink);
  }

  .facade__play svg {
    width: 30px;
    height: 30px;
  }

  /* 點擊後注入的 iframe（JS 建立，沒有 scoped 屬性，走 :global） */
  .facade :global(.facade__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--paper-alt);
  }

  /* 無法嵌入：縮圖 + 外站連結 */
  .facade__external {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }


  .video__credit {
    margin-top: 12px;
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.03em;
    color: var(--muted);
  }

  .video__credit a {
    margin-left: 8px;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule-soft);
    white-space: nowrap;
  }

  .video__credit a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 640px) {
    .facade__play {
      width: 56px;
      height: 56px;
    }

    .facade__play svg {
      width: 22px;
      height: 22px;
    }
  }
</style>
