---
/**
 * 按讚 + 分享元件（繼承自 JP¥ ONLINE，去掉 Google 偏好來源連結）
 *
 * - 按讚：Google Apps Script Web App（URL 設於 src/data/site.ts → SITE.likesApiUrl）
 *         localStorage 標記「我已按過」避免重複觸發 API
 *         若 likesApiUrl 為空字串，整個按讚按鈕不渲染（只保留分享）
 * - 分享：複製連結 / LINE / Facebook / Threads / X / 系統原生分享
 * - GA：data-ga-cta 觸發既有 cta_click，並額外發 like_click / share_click 精細事件
 *
 * Props.slug 建議帶 collection 前綴避免撞名：work:<slug> / post:<urlSlug> / creator:<slug>
 */
import { SITE } from '../data/site';

interface Props {
  slug: string;
  title: string;
  url: string;
  /** 顯示在 GA 事件 cta_location */
  location?: string;
}

const { slug, title, url, location = 'entry_footer' } = Astro.props;
const likesApiUrl = SITE.likesApiUrl || '';
const likesEnabled = !!likesApiUrl;
const domId = slug.replace(/[^a-z0-9-]/gi, '-');
---

<section
  class="sharelike"
  aria-label={likesEnabled ? '按讚與分享' : '分享'}
  data-slug={slug}
  data-url={url}
  data-api-url={likesApiUrl}
>
  <div class="sharelike__row">
    {likesEnabled && (
      <button
        type="button"
        class="sharelike__like"
        data-ga-cta="like"
        data-ga-location={location}
        aria-pressed="false"
        aria-label="按讚"
      >
        <span class="sharelike__heart" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path
              d="M12 21s-7.5-4.6-9.5-9.5C1.1 7.6 3.7 4 7.4 4c2 0 3.6 1.1 4.6 2.6C13 5.1 14.6 4 16.6 4 20.3 4 22.9 7.6 21.5 11.5 19.5 16.4 12 21 12 21z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span class="sharelike__count" aria-live="polite">—</span>
        <span class="sharelike__like-label">按讚</span>
      </button>
    )}

    {likesEnabled && <span class="sharelike__divider" aria-hidden="true"></span>}

    <span class="sharelike__label">分享</span>

    <ul class="sharelike__shares" id={`sharelike-menu-${domId}`} role="list">
      <li>
        <button
          type="button"
          class="sharelike__share-btn"
          data-share="copy"
          data-ga-cta="share_copy"
          data-ga-location={location}
          aria-label="複製連結"
        >
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="M9 17H7a4 4 0 110-8h2M15 7h2a4 4 0 110 8h-2M8 13h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span>連結</span>
        </button>
      </li>
      <li>
        <a
          class="sharelike__share-btn"
          href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(url)}`}
          target="_blank"
          rel="noopener noreferrer"
          data-share="line"
          data-ga-cta="share_line"
          data-ga-location={location}
          aria-label="分享到 LINE"
        >
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="M12 3C6.5 3 2 6.6 2 11c0 4 3.6 7.3 8.5 7.9.4.1.8.3.9.6.1.3 0 .8 0 1.1l-.1.5c-.1.4-.4 1.4 1.2.8 1.7-.7 8.9-5.2 12.1-9C26 9.4 22 3 12 3z" fill="currentColor"/>
          </svg>
          <span>LINE</span>
        </a>
      </li>
      <li>
        <a
          class="sharelike__share-btn"
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`}
          target="_blank"
          rel="noopener noreferrer"
          data-share="facebook"
          data-ga-cta="share_facebook"
          data-ga-location={location}
          aria-label="分享到 Facebook"
        >
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="M13.5 21v-7.5h2.5l.5-3h-3V8.6c0-.9.3-1.5 1.6-1.5H17V4.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1V10.5H8v3h2.6V21h2.9z" fill="currentColor"/>
          </svg>
          <span>Facebook</span>
        </a>
      </li>
      <li>
        <a
          class="sharelike__share-btn"
          href={`https://www.threads.com/intent/post?text=${encodeURIComponent(`${title} ${url}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          data-share="threads"
          data-ga-cta="share_threads"
          data-ga-location={location}
          aria-label="分享到 Threads"
        >
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="M12.2 21c-3 0-5.2-1-6.7-3C4.1 16.2 3.4 13.7 3.4 12c0-1.7.7-4.2 2.1-6 1.5-2 3.7-3 6.7-3 3.4 0 5.6 1.5 6.8 2.7 1 1 1.7 2.4 2 3.9l-2 .5c-.5-2.5-2.4-3.9-6.8-3.9-2.3 0-4 .7-5 2.1C6.2 9.7 5.6 11.6 5.6 12c0 .4.6 2.3 1.6 3.7 1 1.4 2.7 2.1 5 2.1 2.1 0 3.6-.5 4.5-1.4.6-.6.9-1.3.9-2 0-.7-.4-1.3-1.1-1.7-.7-.4-1.7-.6-2.8-.5-.1-.7.4-1.6 1.5-2 1.6-.6 4 .2 4.6 2.7.6 2.5-.7 4.4-1.9 5.5-1.5 1.4-3.5 2.1-6.1 2.1z" fill="currentColor"/>
          </svg>
          <span>Threads</span>
        </a>
      </li>
      <li>
        <a
          class="sharelike__share-btn"
          href={`https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`}
          target="_blank"
          rel="noopener noreferrer"
          data-share="x"
          data-ga-cta="share_x"
          data-ga-location={location}
          aria-label="分享到 X"
        >
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="M17.5 3h3l-7.1 8.1L21.7 21h-6.3l-4.6-6-5.3 6H2.5l7.6-8.7L2.3 3h6.4l4.2 5.5L17.5 3zm-1.1 16.2h1.7L7.7 4.7H5.9l10.5 14.5z" fill="currentColor"/>
          </svg>
          <span>X</span>
        </a>
      </li>
      <li>
        <button
          type="button"
          class="sharelike__share-btn sharelike__native"
          data-share="native"
          data-ga-cta="share_native"
          data-ga-location={location}
          aria-label="用其他應用分享"
          hidden
        >
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="M12 4v12M12 4l-4 4M12 4l4 4M5 14v5a1 1 0 001 1h12a1 1 0 001-1v-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>其他</span>
        </button>
      </li>
    </ul>
  </div>

  <p class="sharelike__toast" role="status" aria-live="polite" hidden>已複製連結</p>
</section>

<style>
  .sharelike {
    max-width: 46em;
    margin: 28px 0 8px;
    padding: 14px 18px 12px;
    background: var(--paper-white);
    border: 1px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .sharelike__row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
  }

  /* ── 按讚按鈕 ───────────────────────────── */
  .sharelike__like {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--ink);
    cursor: pointer;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--fs-sm);
    transition:
      transform 140ms var(--ease-out),
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out);
  }
  .sharelike__like:hover {
    transform: translate(-1px, -1px);
    background: var(--ink);
    color: var(--paper);
  }
  .sharelike__like:active {
    transform: translate(1px, 1px);
  }
  .sharelike__like.is-liked {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent-ink);
  }
  .sharelike__like.is-liked:hover {
    background: var(--accent-ink);
    color: #fff;
  }
  .sharelike__like[disabled] {
    cursor: default;
  }

  .sharelike__heart {
    display: inline-flex;
    width: 18px;
    height: 18px;
  }
  .sharelike__heart svg {
    width: 100%;
    height: 100%;
  }
  .sharelike__like.is-liked .sharelike__heart svg path {
    fill: currentColor;
  }
  .sharelike__like.is-bumping .sharelike__heart {
    animation: sharelike-bump 360ms var(--ease-out);
  }
  @keyframes sharelike-bump {
    0% { transform: scale(1); }
    35% { transform: scale(1.35); }
    60% { transform: scale(0.92); }
    100% { transform: scale(1); }
  }

  .sharelike__count {
    font-variant-numeric: tabular-nums;
    font-weight: 900;
    min-width: 1.5em;
    text-align: right;
  }
  .sharelike__like-label {
    font-family: var(--font-caps);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: inherit;
  }

  .sharelike__divider {
    width: 1px;
    height: 22px;
    background: var(--rule-soft);
    margin: 0 2px;
  }

  .sharelike__label {
    font-family: var(--font-caps);
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── 分享按鈕列 ─────────────────────────── */
  .sharelike__shares {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sharelike__share-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px;
    min-height: 36px;
    background: var(--paper);
    color: var(--ink-soft);
    border: 1px solid var(--rule-soft);
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
    transition: color 150ms var(--ease-out), border-color 150ms var(--ease-out), background 150ms var(--ease-out);
  }
  .sharelike__share-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--paper-white);
  }
  .sharelike__share-btn svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .sharelike__share-btn[hidden] {
    display: none;
  }

  .sharelike__toast {
    margin: 10px 0 0;
    font-family: var(--font-caps);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    color: var(--accent-ink);
  }
  .sharelike__toast[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .sharelike {
      padding: 12px 14px 10px;
    }
  }
</style>

<script>
  (() => {
    const roots = document.querySelectorAll<HTMLElement>('.sharelike');
    roots.forEach((root) => {
      const slug = root.getAttribute('data-slug') || '';
      const apiUrl = (root.getAttribute('data-api-url') || '').replace(/\/$/, '');
      const likeBtn = root.querySelector<HTMLButtonElement>('.sharelike__like');
      const countEl = root.querySelector<HTMLElement>('.sharelike__count');
      const toastEl = root.querySelector<HTMLElement>('.sharelike__toast');
      const nativeBtn = root.querySelector<HTMLButtonElement>('[data-share="native"]');
      const copyBtn = root.querySelector<HTMLButtonElement>('[data-share="copy"]');
      const localKey = `aifm-liked:${slug}`;

      const gtag = (window as any).gtag as ((...args: any[]) => void) | undefined;

      let toastTimer: number | undefined;
      const showToast = (msg: string) => {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.hidden = false;
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => { toastEl.hidden = true; }, 2400);
      };

      const isLikedLocally = () => {
        try { return localStorage.getItem(localKey) === '1'; } catch { return false; }
      };
      const markLikedLocally = () => {
        try { localStorage.setItem(localKey, '1'); } catch { /* ignore */ }
      };
      const applyLikedUI = () => {
        if (!likeBtn) return;
        likeBtn.classList.add('is-liked');
        likeBtn.setAttribute('aria-pressed', 'true');
        likeBtn.disabled = true;
      };

      const buildUrl = (action: 'get' | 'increment') =>
        `${apiUrl}?action=${action}&slug=${encodeURIComponent(slug)}`;

      if (likeBtn && apiUrl) {
        if (isLikedLocally()) applyLikedUI();

        fetch(buildUrl('get'))
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('http_' + r.status))))
          .then((data: { count?: number }) => {
            if (countEl && typeof data.count === 'number') {
              countEl.textContent = String(data.count);
              countEl.setAttribute('data-count', String(data.count));
            }
          })
          .catch(() => {
            if (countEl) countEl.textContent = '—';
          });

        likeBtn.addEventListener('click', async () => {
          if (likeBtn.disabled) return;
          const currentCount = parseInt(countEl?.getAttribute('data-count') || '0', 10) || 0;
          if (countEl) countEl.textContent = String(currentCount + 1);
          applyLikedUI();
          markLikedLocally();
          likeBtn.classList.add('is-bumping');
          window.setTimeout(() => likeBtn.classList.remove('is-bumping'), 400);

          try {
            const res = await fetch(buildUrl('increment'));
            if (!res.ok) throw new Error('http_' + res.status);
            const data = await res.json();
            const realCount = typeof data.count === 'number' ? data.count : null;
            if (countEl && realCount !== null) {
              countEl.textContent = String(realCount);
              countEl.setAttribute('data-count', String(realCount));
            }
            if (gtag) gtag('event', 'like_click', { entry_slug: slug, count_after: realCount });
          } catch {
            showToast('計數同步失敗，但您的讚已標記');
          }
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const pageUrl = root.dataset.url || window.location.href;
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(pageUrl);
            } else {
              const ta = document.createElement('textarea');
              ta.value = pageUrl;
              ta.style.position = 'fixed';
              ta.style.left = '-9999px';
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }
            showToast('已複製連結');
            if (gtag) gtag('event', 'share_click', { platform: 'copy', entry_slug: slug });
          } catch {
            showToast('複製失敗，請手動複製網址');
          }
        });
      }

      if (nativeBtn && typeof (navigator as any).share === 'function') {
        nativeBtn.hidden = false;
        nativeBtn.addEventListener('click', async () => {
          try {
            await (navigator as any).share({ title: document.title, url: root.dataset.url || window.location.href });
            if (gtag) gtag('event', 'share_click', { platform: 'native', entry_slug: slug });
          } catch {
            /* 使用者取消分享 */
          }
        });
      }

      root.querySelectorAll('[data-share]').forEach((el) => {
        const platform = el.getAttribute('data-share') || '';
        if (platform === 'copy' || platform === 'native') return;
        el.addEventListener('click', () => {
          if (gtag) gtag('event', 'share_click', { platform, entry_slug: slug });
        });
      });
    });
  })();
</script>
