---
/**
 * 作品卡（16:9 全彩縮圖 + 標題 + 創作者 + 年份・類型・時長）
 *
 * 根元素固定為 <article class="card" data-work-card>，內部 hook class 不可改：
 *   .card__link  .card__figure img  .card__badge  .card__title  .card__creators  .card__meta
 * MoreList 會 clone 第一張當模板，再用 /more/<key>/<n>.json 的資料填入。
 *
 * 創作者連結不能巢狀在 .card__link 裡（<a> 不可包 <a>），因此 .card__creators 放在連結之外。
 */
import { Image } from 'astro:assets';
import type { Work } from '../data/queries';
import { fmtDuration } from '../data/queries';
import { getWorkAwardBadge } from '../data/awards';
import { genreLabel } from '../data/genres';
import { routes } from '../data/site';

interface Props {
  work: Work;
  /** 創作者頁自己的作品格用 false（人已在頁面上，不必重複） */
  showCreators?: boolean;
  loading?: 'lazy' | 'eager';
}

const { work, showCreators = true, loading = 'lazy' } = Astro.props;
const { title, slug, year, genre, durationSec, thumb, thumbAlt, awards } = work.data;

const duration = fmtDuration(durationSec);
const meta = [String(year), genreLabel(genre), duration].filter(Boolean).join('・');
const awardBadge = getWorkAwardBadge(awards);
---

<article class="card" data-work-card>
  <a href={routes.work(slug)} class="card__link">
    <figure class="card__figure frame frame--work">
      <Image
        src={thumb}
        alt={thumbAlt}
        width={640}
        height={360}
        widths={[480, 640, 960, 1280]}
        sizes="(max-width: 640px) 92vw, (max-width: 1240px) 45vw, 380px"
        loading={loading}
        decoding="async"
      />
      <span
        class="card__badge badge"
        data-award-status={awardBadge?.status}
        aria-label={awardBadge?.ariaLabel}
        hidden={!awardBadge}
      >{awardBadge?.label}</span>
    </figure>
    <h3 class="card__title">{title}</h3>
  </a>

  {showCreators && (
    <p class="card__creators">
      {work.creators.map((c, i) => (
        <>{i > 0 && '、'}<a href={routes.creator(c.slug)}>{c.name}</a></>
      ))}
    </p>
  )}

  <p class="card__meta">{meta}</p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .card__link {
    display: block;
    color: inherit;
  }

  .card__figure {
    margin: 0 0 12px;
  }

  .card__figure img {
    transition: transform 500ms var(--ease-out);
  }

  .card__link:hover .card__figure img {
    transform: scale(1.02);
  }

  .card__badge {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    pointer-events: none;
  }

  .card__badge[hidden] {
    display: none;
  }

  .card__badge[data-award-status='finalist'],
  .card__badge[data-award-status='selection'] {
    color: var(--ink);
    background: var(--paper-raised);
    border-left: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .card__title {
    font-size: var(--fs-md);
    line-height: 1.45;
    letter-spacing: 0.01em;
    transition: color 160ms var(--ease-out);
  }

  .card__link:hover .card__title {
    color: var(--accent);
  }

  /* 創作者連結：MoreList 會用 JS 重建 <a>，因此樣式走 :global 才能套到新節點 */
  .card__creators {
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .card__creators :global(a) {
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule-soft);
    transition: color 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  .card__creators :global(a:hover) {
    color: var(--accent);
    border-color: var(--accent);
  }

  .card__meta {
    font-family: var(--font-caps);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
