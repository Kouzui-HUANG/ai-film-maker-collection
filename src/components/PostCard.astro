---
/**
 * PostCard — 訪談／教學卡片（props 契約見 docs/dev/CONTRACT.md §4）
 *
 *   <PostCard post={Post} variant="row" | "stacked" />
 *     row     ：桌機縮圖左 220px、內容右；≤640px 自動改為圖上字下。
 *               自帶 padding 與下方米灰細線，直接疊在列表裡即可。
 *     stacked ：圖上字下、無外框線（首頁 READ 區或格網排版用，間距由消費端決定）。
 *
 * - 整張卡是一個 <a>（連到 /post/<urlSlug>/）
 * - 封面用 global 的 .frame--post：grayscale(0.5)，hover 回全彩
 * - 縮圖左上 .badge 標「訪談／教學」；教學另加難度小章
 * - 根元素帶 data-type / data-level，供列表頁純前端篩選
 */
import { Image } from 'astro:assets';
import type { Post } from '../data/queries';
import { routes } from '../data/site';
import { POST_TYPE_LABEL, LEVEL_LABEL } from '../data/genres';
import { fmtDate } from '../data/events';

interface Props {
  post: Post;
  variant?: 'row' | 'stacked';
  /** 首屏卡片傳 "eager"，其餘預設 lazy */
  loading?: 'lazy' | 'eager';
  /** 覆寫 <Image sizes>（stacked 排進多欄格網時可依欄寬指定） */
  sizes?: string;
}

const { post, variant = 'row', loading = 'lazy', sizes } = Astro.props;
const { title, excerpt, type, urlSlug, author, date, cover, coverAlt, readMin, level } = post.data;

const typeLabel = POST_TYPE_LABEL[type]?.label ?? type;
const levelLabel = type === 'tutorial' && level ? (LEVEL_LABEL[level] ?? level) : null;
const peopleLabel = type === 'interview' ? '受訪者' : '相關創作者';
const people = post.creators.map((c) => c.name).join('、');

const imgSizes =
  sizes ??
  (variant === 'row'
    ? '(max-width: 640px) calc(100vw - 32px), 220px'
    : '(max-width: 640px) calc(100vw - 32px), (max-width: 1240px) 45vw, 400px');
---

<article class={`post-card post-card--${variant}`} data-type={type} data-level={level ?? undefined}>
  <a href={routes.post(urlSlug)} class="post-card__link">
    <figure class="frame frame--post post-card__figure">
      <Image
        src={cover}
        alt={coverAlt}
        width={440}
        height={248}
        widths={[440, 660, 880]}
        sizes={imgSizes}
        loading={loading}
        fetchpriority={loading === 'eager' ? 'high' : undefined}
        decoding="async"
      />
      <span class="post-card__badges" aria-hidden="true">
        <span class="badge">{typeLabel}</span>
        {levelLabel && <span class="post-card__level">{levelLabel}</span>}
      </span>
    </figure>

    <div class="post-card__body">
      <h3 class="post-card__title">{title}</h3>
      <p class="post-card__excerpt">{excerpt}</p>
      {people && (
        <p class="post-card__people">
          <span class="post-card__people-label">{peopleLabel}</span>
          <span class="post-card__people-names">{people}</span>
        </p>
      )}
      <div class="post-card__foot">
        <span class="byline">文／{author}</span>
        <time class="date-chip" datetime={date}>{fmtDate(date)}</time>
        <span class="date-chip">閱讀 {readMin} 分鐘</span>
        <span class="visually-hidden">・{typeLabel}{levelLabel ? `・${levelLabel}` : ''}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card--row {
    padding: 24px 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .post-card__link {
    display: grid;
    gap: 20px;
    color: inherit;
  }
  .post-card__link:hover {
    color: inherit;
  }

  /* row：縮圖左 220px、內容右 */
  .post-card--row .post-card__link {
    grid-template-columns: 220px minmax(0, 1fr);
    align-items: start;
  }

  /* stacked：圖上字下 */
  .post-card--stacked .post-card__link {
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .post-card__figure {
    min-width: 0;
  }

  /* 縮圖左上：type badge ＋ 難度小章 */
  .post-card__badges {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: stretch;
    z-index: 1;
    pointer-events: none;
  }
  .post-card__level {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px 3px;
    font-family: var(--font-caps);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    line-height: 1;
    color: var(--ink);
    background: var(--paper-white);
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .post-card__title {
    font-size: var(--fs-lg);
    line-height: 1.4;
    letter-spacing: 0.01em;
    transition: color 160ms var(--ease-out);
  }
  .post-card--stacked .post-card__title {
    font-size: var(--fs-md);
  }
  .post-card__link:hover .post-card__title,
  .post-card__link:focus-visible .post-card__title {
    color: var(--accent);
  }

  .post-card__excerpt {
    font-family: var(--font-serif);
    color: var(--ink-soft);
    font-size: var(--fs-sm);
    line-height: 1.8;
    max-width: 46em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__people {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: var(--fs-xs);
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }
  .post-card__people-label {
    font-family: var(--font-caps);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--muted);
    white-space: nowrap;
  }
  .post-card__people-names {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--ink);
  }

  .post-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    padding-top: 8px;
    border-top: 1px dashed var(--rule-soft);
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .post-card--row {
      padding: 18px 0;
    }
    .post-card--row .post-card__link {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .post-card__title {
      font-size: var(--fs-md);
    }
  }
</style>
