<script>
  import {
    FIELDS,
    CUSTOM_MODEL,
    modelById,
    presetById,
    normalize,
    defaultParams,
    fromSearch,
    toSearch,
    describe,
    summaryText,
    sliderFill,
    sliderValue,
    valueText,
    type NumField,
    type Params,
    type Texts,
  } from '../../data/cost-calculator';

  /* describe() 的欄位 → 頁面上的 data-out 名稱；空字串時要整行藏起來的另外標 */
  const OUT: [keyof Texts, string][] = [
    ['hintLen', 'hint-len'],
    ['hintEps', 'hint-eps'],
    ['hintAdopt', 'hint-adopt'],
    ['hintRev', 'hint-rev'],
    ['hintPrice', 'hint-price'],
    ['hintRate', 'hint-rate'],
    ['hintDays', 'hint-days'],
    ['compute', 'compute'],
    ['total', 'total'],
    ['computeWan', 'computeWan'],
    ['totalWan', 'totalWan'],
    ['genDesc', 'genDesc'],
    ['totalNote', 'totalNote'],
    ['laborRow', 'laborRow'],
    ['perMin', 'perMin'],
    ['computePct', 'computePct'],
    ['laborPct', 'laborPct'],
    ['presetStatus', 'presetStatus'],
    ['formula', 'formula'],
  ];
  const HIDE_WHEN_EMPTY = new Set(['computeWan', 'totalWan']);

  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) setup(root);

  function setup(root: HTMLElement) {
    const siteName = root.dataset.siteName ?? '';
    let state: Params = fromSearch(location.search) ?? defaultParams();

    const nums = [...root.querySelectorAll<HTMLInputElement>('[data-num]')];
    const ranges = [...root.querySelectorAll<HTMLInputElement>('[data-range]')];
    const presetBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-preset]')];
    const modelInputs = [...root.querySelectorAll<HTMLInputElement>('[data-model]')];
    const laborInput = root.querySelector<HTMLInputElement>('[data-labor]');
    const laborFields = root.querySelector<HTMLElement>('[data-labor-fields]');
    const shareBlocks = [...root.querySelectorAll<HTMLElement>('[data-share]')];
    const shareBars = [...root.querySelectorAll<HTMLElement>('[data-share-bar]')];
    const shareFills = [...root.querySelectorAll<HTMLElement>('[data-share-fill]')];
    const live = root.querySelector<HTMLElement>('[data-live]');
    const outs = new Map<string, HTMLElement[]>();
    root.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => {
      const key = el.dataset.out ?? '';
      outs.set(key, [...(outs.get(key) ?? []), el]);
    });

    function render(source?: Element) {
      const t = describe(state);
      for (const [field, key] of OUT) {
        const text = String(t[field]);
        for (const el of outs.get(key) ?? []) {
          if (el.textContent !== text) el.textContent = text;
          if (HIDE_WHEN_EMPTY.has(key)) el.hidden = text === '';
        }
      }
      for (const el of nums) {
        const f = el.dataset.num as NumField;
        /* 正在輸入的數字框不回寫，免得打到一半被改掉 */
        if (el !== source && el !== document.activeElement) el.value = String(state[f]);
      }
      for (const el of ranges) {
        const f = el.dataset.range as NumField;
        if (el !== source) el.value = String(sliderValue(f, state));
        el.style.setProperty('--fill', sliderFill(f, state));
        el.setAttribute('aria-valuetext', valueText(f, state));
      }
      for (const el of modelInputs) el.checked = el.value === state.model;
      if (laborInput) laborInput.checked = state.labor;
      if (laborFields) {
        laborFields.toggleAttribute('data-off', !state.labor);
        laborFields.querySelectorAll('input').forEach((el) => (el.disabled = !state.labor));
      }
      shareBlocks.forEach((el) => (el.hidden = !state.labor));
      shareFills.forEach((el) => (el.style.width = t.shareWidth));
      shareBars.forEach((el) => el.setAttribute('aria-label', t.shareLabel));
      presetBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.preset === t.presetId)));
    }

    /* ── 網址與讀屏：停手後才更新 ── */
    let urlTimer = 0;
    let liveTimer = 0;
    const shareUrl = () => `${location.origin}${location.pathname}${toSearch(state)}`;
    function writeUrl() {
      window.clearTimeout(urlTimer);
      history.replaceState(history.state, '', `${location.pathname}${toSearch(state)}${location.hash}`);
    }
    function announce(text: string) {
      if (live) live.textContent = text;
    }

    function update(next: Partial<Params>, source?: Element) {
      state = { ...state, ...next };
      render(source);
      window.clearTimeout(urlTimer);
      urlTimer = window.setTimeout(writeUrl, 300);
      window.clearTimeout(liveTimer);
      liveTimer = window.setTimeout(() => announce(describe(state).live), 800);
    }

    /* 單價被手動改過就換成「自訂單價」；改回目前模型的原價則維持原模型 */
    function priceChange(price: number): Partial<Params> {
      const m = modelById(state.model);
      return { price, model: m && m.price === price ? m.id : CUSTOM_MODEL };
    }

    function fieldChange(field: NumField, value: number): Partial<Params> {
      return field === 'price' ? priceChange(value) : ({ [field]: value } as Partial<Params>);
    }

    for (const el of ranges) {
      el.addEventListener('input', () => {
        const field = el.dataset.range as NumField;
        const steps = FIELDS[field].steps;
        const value = normalize(field, steps ? steps[Number(el.value)] : el.value);
        if (value !== null) update(fieldChange(field, value), el);
      });
    }

    for (const el of nums) {
      el.addEventListener('input', () => {
        const field = el.dataset.num as NumField;
        const value = normalize(field, el.value);
        if (value !== null) update(fieldChange(field, value), el);
      });
      /* 離開數字框時顯示整理過的值（夾到範圍內、去掉多餘小數） */
      el.addEventListener('change', () => {
        el.value = String(state[el.dataset.num as NumField]);
      });
    }

    for (const el of modelInputs) {
      el.addEventListener('change', () => {
        if (!el.checked) return;
        const m = modelById(el.value);
        update(m ? { model: m.id, price: m.price } : { model: CUSTOM_MODEL });
      });
    }

    laborInput?.addEventListener('change', () => update({ labor: laborInput.checked }));

    for (const btn of presetBtns) {
      btn.addEventListener('click', () => {
        const preset = presetById(btn.dataset.preset ?? '');
        if (preset) update({ ...preset.params });
      });
    }

    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.textContent ?? '';
      let timer = 0;
      btn.addEventListener('click', async () => {
        writeUrl();
        const isLink = btn.dataset.copy === 'link';
        const ok = await copyText(isLink ? shareUrl() : summaryText(state, shareUrl(), siteName));
        btn.textContent = ok ? '已複製' : '無法複製';
        announce(ok ? (isLink ? '已複製試算連結' : '已複製試算算式') : '無法複製，請手動選取算式');
        window.clearTimeout(timer);
        timer = window.setTimeout(() => (btn.textContent = label), 2000);
      });
    });

    render();
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {
      /* 落到下面的舊式複製 */
    }
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.top = '0';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    ta.remove();
    return ok;
  }
</script>
