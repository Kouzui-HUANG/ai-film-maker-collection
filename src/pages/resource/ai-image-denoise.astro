---
/**
 * /resource/ai-image-denoise/ — AI 圖片色雜訊診斷與降噪
 *
 * - 計算：src/scripts/denoise/denoise-core.js（演算法）＋ denoise.worker.js（Web Worker）；
 *   互動：src/scripts/denoise/app.ts（放圖、診斷檢視、縮放、比較、降噪、儲存）。DOM 契約是下方的 data-dn-* 屬性
 * - 隱私：圖片只在瀏覽器分頁裡處理，整條路上沒有任何網路請求；工具操作不送 GA（不要在工具的按鈕加 data-ga-cta）
 * - 根元素 data-state：init（JS 還沒接手）→ empty → loading → ready（已載入、還沒降噪）→ done；unsupported 是瀏覽器不支援 Worker
 * - 條目資訊（標題、摘要、上線／更新日、封面 alt）在 src/data/resources.mjs；封面 src/assets/resources/<slug>.jpg
 * - schema：WebPage（不用 WebApplication：沒有評分或評論時 Search Console 會列為無效項目）
 * - 麵包屑：首頁 › 工具資源 › 頁名（傳給 BaseLayout，與可見 .crumbs 一致）
 */
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, routes, absRoutes, absAsset } from '../../data/site';
import { fmtDate } from '../../data/events';
import { RESOURCES } from '../../data/resources.mjs';
import { GRADES, GRADE_STEPS } from '../../scripts/denoise/grades.js';

const SLUG = 'ai-image-denoise';
const resource = RESOURCES.find((r) => r.slug === SLUG);
if (!resource) throw new Error(`src/data/resources.mjs 缺少「${SLUG}」`);

const covers = import.meta.glob<{ default: ImageMetadata }>('../../assets/resources/*.jpg', { eager: true });
const cover = covers[`../../assets/resources/${SLUG}.jpg`]?.default;
if (!cover) throw new Error(`缺封面：src/assets/resources/${SLUG}.jpg`);

/* app.ts 的上限與預設值；改了要兩邊一起改 */
const MAX_SIDE = 4096;
const MAX_WAN = Math.round((MAX_SIDE * MAX_SIDE) / 1e4).toLocaleString('zh-TW');
const DEFAULT_CHROMA = 5;
const DEFAULT_SKIN = 40;

/* 色雜訊等級的區間文字：「未滿 0.5」「0.5～1」…「4 以上」 */
const gradeRange = (i: number) =>
  i === 0 ? `未滿 ${GRADE_STEPS[0]}` : i === GRADE_STEPS.length ? `${GRADE_STEPS[i - 1]} 以上` : `${GRADE_STEPS[i - 1]}～${GRADE_STEPS[i]}`;

const title = resource.title;
const seoTitle = 'AI 圖片降噪：在瀏覽器判斷色雜訊等級，一鍵抹平彩色顆粒與色斑';
const description =
  'AI 生成的圖放大常見彩色顆粒和斑駁色塊。把圖放進瀏覽器，先看 1 到 5 級的色雜訊等級，再用「只看顏色」檢視找出雜訊在哪裡，一鍵抹平顏色、保留亮度與細節，人像可順便淡化膚色斑駁。' +
  '全部在你的電腦上計算，圖片不會上傳。';

const pageUrl = absRoutes.resource(SLUG);
const breadcrumbs = [
  { name: '工具資源', item: absRoutes.resources() },
  { name: title, item: pageUrl },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageUrl,
  url: pageUrl,
  name: title,
  description,
  inLanguage: 'zh-Hant-TW',
  image: absAsset(cover.src),
  datePublished: resource.published,
  dateModified: resource.updated,
  isPartOf: { '@id': `${SITE.url}/#website` },
  publisher: { '@id': `${SITE.url}/#organization` },
  keywords: 'AI 圖片降噪, 色雜訊, 色雜訊等級, 彩色雜訊, 色斑, AI 生圖雜訊, guided filter, 膚色均勻',
};
---

<BaseLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  ogImage={cover.src}
  schemas={[pageSchema]}
  breadcrumbs={breadcrumbs}
>
  <div class="page">
    <div class="page-inner page-inner--wide">
      <nav class="crumbs" aria-label="麵包屑">
        <a href={routes.home()}>首頁</a><span aria-hidden="true">／</span>
        <a href={routes.resources()}>工具資源</a><span aria-hidden="true">／</span>
        <span aria-current="page">{title}</span>
      </nav>

      <header class="page-head">
        <div class="rule-double"></div>
        <h1 class="page-title">{title}</h1>
        <p class="page-lead">
          把 AI 生成的圖放進來，先看色雜訊等級（1 到 5 級）知道彩色的小顆粒和斑駁的色塊有多嚴重，用「只看顏色」看它們在哪裡，再一鍵抹平；亮度和細節不動，人像可以順便淡化膚色的斑駁。全部在你的瀏覽器裡計算，圖片不會上傳。
        </p>
        <p class="page-meta">在瀏覽器裡計算　圖片不上傳　更新 {fmtDate(resource.updated)}</p>
      </header>

      <section class="dn" data-denoise data-state="init" aria-labelledby="dn-title">
        <h2 id="dn-title" class="visually-hidden">降噪工具</h2>

        <noscript>
          <p class="dn__notice">這個工具需要 JavaScript：讀圖、計算和儲存都在你的瀏覽器裡執行。請開啟 JavaScript 後重新整理。下方的說明不需要 JavaScript 也能閱讀。</p>
        </noscript>
        <p class="dn__notice dn__notice--unsupported">這個瀏覽器不支援背景計算（Web Worker），沒辦法執行。請改用最新版的 Chrome、Edge、Safari 或 Firefox。</p>

        <input class="visually-hidden" type="file" accept="image/*" tabindex="-1" aria-hidden="true" data-dn-file />

        <div class="dn__grid">
          <!-- 檢視區 ─────────────────────────────── -->
          <div class="dn__stage">
            <div class="dn__toolbar">
              <div class="dn__bar-group" role="group" aria-label="檢視">
                <span class="dn__bar-label" aria-hidden="true">檢視</span>
                <button type="button" class="chip" data-dn-view="photo" aria-pressed="false">一般</button>
                <button type="button" class="chip" data-dn-view="chroma" aria-pressed="true">只看顏色</button>
                <button type="button" class="chip" data-dn-view="diff" aria-pressed="false" title="按「一鍵降噪」之後才能看">改變幅度</button>
                <button type="button" class="chip" data-dn-view="mask" aria-pressed="false" title="按「一鍵降噪」之後才能看">膚色範圍</button>
              </div>
              <div class="dn__bar-group" role="group" aria-label="縮放">
                <span class="dn__bar-label" aria-hidden="true">縮放</span>
                <button type="button" class="chip" data-dn-zoom="fit" aria-pressed="true">符合</button>
                <button type="button" class="chip" data-dn-zoom="1" aria-pressed="false">100%</button>
                <button type="button" class="chip" data-dn-zoom="2" aria-pressed="false">200%</button>
              </div>
            </div>

            <div class="dn__viewer">
              <!-- 還沒放圖 -->
              <div class="dn__drop" data-dn-drop>
                <p class="dn__drop-title">
                  <span class="dn__fine">把圖片拖到這裡</span><span class="dn__coarse">選一張圖片開始</span>
                </p>
                <p class="dn__drop-text dn__fine">或按 <kbd>⌘</kbd> <kbd>V</kbd>／<kbd>Ctrl</kbd> <kbd>V</kbd> 貼上剛複製的圖</p>
                <button type="button" class="btn" data-dn-pick>選擇圖片</button>
                <p class="dn__drop-note">PNG、JPEG、WebP 等瀏覽器看得懂的格式，上限 {MAX_WAN} 萬像素（{MAX_SIDE} × {MAX_SIDE}）。<br />圖片只在這個分頁裡計算，不會上傳。</p>
              </div>

              <!-- 放了圖 -->
              <div class="dn__scroll" data-dn-scroll>
                <div class="dn__wrap" data-dn-wrap>
                  <canvas class="dn__canvas" data-dn-canvas="before" aria-label="原圖"></canvas>
                  <canvas class="dn__canvas" data-dn-canvas="after" aria-label="降噪後" hidden></canvas>
                </div>
              </div>
              <p class="dn__busy" aria-hidden="true"><span class="dn__spin"></span>計算中</p>
            </div>

            <div class="dn__below">
              <div class="dn__compare" role="group" aria-label="比較原圖和降噪後" data-dn-compare-group>
                <button type="button" class="dn__seg" data-dn-compare="before" aria-pressed="true">原圖</button>
                <button type="button" class="dn__seg" data-dn-compare="after" aria-pressed="false">降噪後</button>
              </div>
              <p class="dn__zoom-now" data-dn-zoom-now></p>
            </div>
            <p class="dn__caption" data-dn-caption>
              只看顏色：亮度一律拉平、顏色放大 4 倍。斑駁的色塊、彩色的小顆粒就是色雜訊。
            </p>
            <div class="dn__legend" data-dn-legend="diff" hidden>
              <span class="dn__legend-scale" aria-hidden="true">
                <span class="dn__legend-bar dn__legend-bar--heat"></span>
                <span class="dn__legend-ticks"><span>0</span><span>3</span><span>6 以上</span></span>
              </span>
              <span class="dn__legend-text">ΔE：降噪前後的顏色差。大約 2 以上，肉眼才分得出來。</span>
            </div>
            <div class="dn__legend" data-dn-legend="mask" hidden>
              <span class="dn__legend-key" aria-hidden="true"></span>
              <span class="dn__legend-text">靛藍越濃，膚色均勻作用得越多；灰色的地方不受影響。</span>
            </div>
          </div>

          <!-- 設定與儲存 ─────────────────────────── -->
          <aside class="dn__panel" aria-label="降噪設定">
            <div class="dn__file">
              <p class="dn__file-name" data-dn-info-name>還沒有圖片</p>
              <p class="dn__file-meta" data-dn-info-meta>放一張圖進來開始</p>
              <button type="button" class="btn btn--ghost dn__file-pick" data-dn-pick>換一張</button>
            </div>

            <section class="group grade" aria-labelledby="dn-grade-title" data-dn-grade data-level="">
              <h3 class="group__legend" id="dn-grade-title">
                <span class="group__no">01</span><span class="group__title">色雜訊等級</span>
              </h3>
              <p class="grade__head">
                <span class="grade__num" data-dn-grade-num>–</span><span class="grade__of">／5</span>
                <span class="grade__name" data-dn-grade-name>放圖之後自動判斷</span>
              </p>
              <div class="grade__meter" aria-hidden="true">
                <span class="grade__track" data-dn-grade-track>
                  {GRADES.map(() => <span class="grade__seg" />)}
                </span>
                <span class="grade__names">{GRADES.map((g) => <span>{g.name}</span>)}</span>
              </div>
              <p class="grade__desc" data-dn-grade-desc>
                在亮度平滑的地方（皮膚、天空、牆面）量彩色顆粒和色斑的幅度：1 是乾淨，5 是非常嚴重。
              </p>
              <p class="grade__meta" data-dn-grade-meta></p>
              <div class="grade__after" data-dn-grade-after hidden>
                <span class="grade__after-label">降噪後</span>
                <span class="grade__track grade__track--mini" data-dn-grade-after-track aria-hidden="true">
                  {GRADES.map(() => <span class="grade__seg" />)}
                </span>
                <span class="grade__after-text" data-dn-grade-after-text></span>
              </div>
            </section>

            <fieldset class="group">
              <legend class="group__legend">
                <span class="group__no">02</span><span class="group__title">降噪</span>
              </legend>

              <button type="button" class="btn btn--accent dn__run" data-dn-run disabled>一鍵降噪</button>

              <div class="field">
                <div class="field__head">
                  <label class="field__label" for="dn-chroma">色雜訊</label>
                  <output class="field__value" for="dn-chroma" data-dn-chroma-out>{DEFAULT_CHROMA}</output>
                </div>
                <input
                  id="dn-chroma"
                  class="field__range"
                  type="range"
                  min="0"
                  max="20"
                  step="1"
                  value={DEFAULT_CHROMA}
                  autocomplete="off"
                  aria-describedby="dn-chroma-hint dn-chroma-note"
                  data-dn-chroma
                  disabled
                  style={`--fill: ${(DEFAULT_CHROMA / 20) * 100}%`}
                />
                <p class="field__hint" id="dn-chroma-hint" data-dn-chroma-hint>照亮度的邊緣，把 {DEFAULT_CHROMA} 像素範圍內的顏色抹平</p>
                <p class="field__note" id="dn-chroma-note">越大抹得越開。只動顏色，亮度和細節不動；0 是不做。</p>
              </div>

              <label class="switch">
                <input class="switch__input" type="checkbox" role="switch" data-dn-portrait disabled />
                <span class="switch__track" aria-hidden="true"><span class="switch__knob"></span></span>
                <span class="switch__text">
                  <span class="switch__label">人像</span>
                  <span class="switch__note">順便淡化膚色的斑駁；不是人像的圖請保持關閉</span>
                </span>
              </label>

              <div class="field dn__skin" data-dn-skin-field data-off>
                <div class="field__head">
                  <label class="field__label" for="dn-skin">膚色均勻</label>
                  <output class="field__value" for="dn-skin" data-dn-skin-out>{DEFAULT_SKIN}%</output>
                </div>
                <input
                  id="dn-skin"
                  class="field__range"
                  type="range"
                  min="0"
                  max="100"
                  step="1"
                  value={DEFAULT_SKIN}
                  autocomplete="off"
                  aria-describedby="dn-skin-note"
                  data-dn-skin
                  disabled
                  style={`--fill: ${DEFAULT_SKIN}%`}
                />
                <p class="field__note" id="dn-skin-note">只在膚色範圍裡，把斑駁、不均勻的亮暗拉回周圍；毛孔、髮絲和五官的邊緣不動。</p>
              </div>

              <div class="dn__row">
                <p class="dn__status" data-dn-status></p>
                <button type="button" class="dn__text-btn" data-dn-reset disabled>回到預設</button>
              </div>
            </fieldset>

            <fieldset class="group">
              <legend class="group__legend">
                <span class="group__no">03</span><span class="group__title">儲存</span>
              </legend>
              <div class="dn__actions">
                <button type="button" class="btn btn--accent" data-dn-save disabled>儲存降噪後的圖</button>
                <button type="button" class="btn btn--ghost" data-dn-copy disabled>複製圖片</button>
              </div>
              <p class="dn__save-note">
                存成「<span data-dn-save-name>原檔名_降噪</span>」，<span data-dn-save-format>格式和原圖一樣</span>。檔案在這台電腦上產生，不經過網路。
              </p>
              <p class="field__note">存下的圖不含原檔的 EXIF、色彩描述檔與 C2PA 內容憑證。</p>
            </fieldset>

            <p class="dn__error" role="alert" data-dn-error hidden></p>
          </aside>
        </div>
        <p class="visually-hidden" aria-live="polite" data-dn-live></p>
      </section>

      <!-- 怎麼運作 ─────────────────────────────── -->
      <section class="notes" aria-labelledby="method-title">
        <div class="section-head">
          <h2 id="method-title" class="section-eyebrow">怎麼運作</h2>
        </div>
        <div class="notes__body">
          <p class="notes__lead">
            AI 生成的圖放大來看，常有兩種顏色的毛病：彩色的小顆粒，以及一塊一塊偏紅、偏綠的斑駁。它們出在顏色，不在亮度，所以這個工具把亮度和顏色拆開處理，只抹平顏色，輪廓、髮絲和紋理都留著。
          </p>
          <dl class="glossary">
            <div class="glossary__item">
              <dt>色雜訊等級</dt>
              <dd>
                <p>
                  在亮度平滑的地方（皮膚、天空、牆面）量彩色顆粒和色斑的典型幅度，換成 1 到 5 級。指數大約等於顏色起伏的色差（ΔE），每升一級，幅度大約加倍：
                </p>
                <ol class="levels">
                  {GRADES.map((g, i) => (
                    <li>
                      <span class="levels__no">{i + 1}</span>
                      <span class="levels__name">{g.name}</span>
                      <span class="levels__range">指數 {gradeRange(i)}</span>
                      <span class="levels__desc">{g.desc}</span>
                    </li>
                  ))}
                </ol>
                <p>
                  做法：先把圖縮小 4 倍，一兩個像素的細顆粒不算，肉眼本來就看不出它的顏色；再把顏色裡跟著亮度走的部分扣掉（陰影、布紋、木紋本身的顏色），只留和亮度無關的起伏，取所有平滑區域的中位數。門檻是在乾淨的圖上加入已知幅度的人工色斑，照肉眼在 100% 下看不看得出來定的。按下「一鍵降噪」後，降噪的結果會用同一把尺再量一次。
                </p>
                <p>
                  它只管顏色的雜訊，不管亮度的顆粒。水彩、做舊這種筆觸本身就帶顏色紋理的畫風，指數會偏高一些；JPEG 壓縮和縮放也會讓指數小幅變動。細節很多、幾乎沒有平滑區域的畫面（全身三視圖、很暗的場景）會只依亮部判斷並標示僅供參考，或顯示無法判斷，這時請直接看「只看顏色」。
                </p>
              </dd>
            </div>
            <div class="glossary__item">
              <dt>色雜訊</dt>
              <dd>
                把圖轉成 Lab 色彩空間：L 是亮度，a、b 是顏色。亮度完全不動，只用 guided filter（導向濾波，He 等人 2010 年提出）把 a、b 照著亮度的邊緣抹平，所以嘴唇的粉紅、頭髮的黑不會滲到皮膚上。滑桿是抹平的範圍，單位是像素，預設 {DEFAULT_CHROMA}；越大抹得越開，0 是不做。
              </dd>
            </div>
            <div class="glossary__item">
              <dt>膚色均勻</dt>
              <dd>
                打開「人像」才會作用，預設 {DEFAULT_SKIN}%。它只在暖色、中等飽和、中等亮度的範圍裡，把對比低、中等大小的斑駁亮暗拉回周圍的亮度；毛孔、髮絲這種 2 像素以下的紋理，和眼睛、鼻孔、唇線、下巴這種有對比的邊緣都不動。沙灘、木頭、夕陽也可能被當成膚色而變平，所以不是人像的圖請保持關閉，或先切到「膚色範圍」看看會動到哪裡。
              </dd>
            </div>
            <div class="glossary__item">
              <dt>只看顏色</dt>
              <dd>
                診斷用的檢視：亮度一律拉成同一個值，顏色放大 4 倍。原本要放大到實際像素、瞇著眼才看得到的色雜訊，在這裡會變成明顯的斑點和色塊；切到「降噪後」，就能看到哪些被抹平了。顏色本來就豐富的畫面（霓虹、花草、彩繪）在這個檢視裡也會很花，那不代表圖髒。
              </dd>
            </div>
            <div class="glossary__item">
              <dt>改變幅度</dt>
              <dd>
                每個像素降噪前後的顏色差（ΔE），用暗到亮的色階畫在調暗的原圖上。平坦的地方亮成一片細點，是被抹掉的色雜訊；顏色交界亮成線，是色邊被修順。它畫的是「這次降噪改了什麼」，不是髒的程度：顏色豐富的畫面交界多，整張都會亮。要判斷髒不髒，請看色雜訊等級，它刻意只量平滑的地方。
              </dd>
            </div>
            <div class="glossary__item">
              <dt>不處理的</dt>
              <dd>
                亮度的顆粒（像底片的粒子）、JPEG 壓縮的方塊、天空的色帶斷層，都不在這個工具的範圍。亮度顆粒故意不動：抹掉它會連細節一起抹掉，畫面就變得像塑膠。
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- 隱私 ─────────────────────────────────── -->
      <section class="notes" aria-labelledby="privacy-title">
        <div class="section-head">
          <h2 id="privacy-title" class="section-eyebrow">圖片不會離開你的電腦</h2>
        </div>
        <div class="notes__body">
          <p class="notes__text">
            圖片從讀進來、計算、到存檔，全程只在這個瀏覽器分頁裡：讀檔是瀏覽器自己解碼，計算在背景執行緒（Web Worker），按「儲存」是瀏覽器在本機產生檔案。網頁裡沒有任何上傳圖片的程式，本站的伺服器也只放靜態網頁，收不到你的圖。
          </p>
          <p class="notes__text">
            想自己驗證：頁面載完之後關掉 Wi-Fi 或拔掉網路線，放圖、降噪、儲存照樣能用。也可以打開瀏覽器的開發者工具，在「網路」分頁裡看，放圖和降噪都不會產生新的連線。唯一可能出現的是本站的流量統計（Google Analytics），它只記錄瀏覽和捲動，不含圖片、檔名或你調的設定。
          </p>
        </div>
      </section>

      <!-- 限制 ─────────────────────────────────── -->
      <section class="notes" aria-labelledby="limits-title">
        <div class="section-head">
          <h2 id="limits-title" class="section-eyebrow">使用前要知道的</h2>
        </div>
        <div class="notes__body">
          <ul class="dn-list">
            <li>
              <strong>尺寸上限 {MAX_WAN} 萬像素</strong>（{MAX_SIDE} × {MAX_SIDE}），這是 iPhone Safari 能處理的最大畫布。計算時每百萬像素大約要 0.1 GB 記憶體，手機上處理 4K 的圖可能會不夠，遇到時請先縮小。2K 的圖在一般電腦上約 0.3 秒算完。
            </li>
            <li>
              <strong>存檔格式和原圖一樣</strong>：PNG 不失真；JPEG、WebP 以 95% 品質重新壓縮；AVIF、HEIC 等其他格式存成 PNG。透明背景會保留。
            </li>
            <li>
              <strong>不保留中繼資料</strong>：存下的圖沒有原檔的 EXIF、色彩描述檔與 C2PA 內容憑證。改過像素的圖本來就無法沿用原本的憑證；作品要標示 AI 生成時，請照發布平台的規定另外標註。
            </li>
            <li>
              <strong>以 sRGB 處理</strong>：Display P3 等廣色域的照片會先被瀏覽器轉成 sRGB，最飽和的顏色可能被壓進 sRGB 的範圍。AI 生成的圖幾乎都是 sRGB，不受影響。
            </li>
          </ul>
        </div>
      </section>

      <p class="back"><a href={routes.resources()}>回工具資源</a></p>
    </div>
  </div>
</BaseLayout>

